#!/bin/sh
# Block commits that contain API keys or secrets

PATTERNS="AIzaSy|pdl_live|pdl_ntfset|SUPABASE_SERVICE_ROLE_KEY=ey|npg_|postgresql://.*:.*@"

if git diff --cached --name-only | xargs grep -lE "$PATTERNS" 2>/dev/null | grep -v "node_modules" | grep -v ".env" | grep -v "package-lock" ; then
  echo ""
  echo "❌ COMMIT BLOCKED: Possible API key or secret detected in staged files."
  echo "   Remove the secret and try again."
  echo ""
  exit 1
fi

exit 0
