generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model LeaderboardEntry {
  id        Int      @id @default(autoincrement())
  alias     String
  score     Int
  topSkill  String
  createdAt DateTime @default(now())
}

model CofounderProfile {
  id        Int      @id @default(autoincrement())
  alias     String
  email     String
  skills    String
  interests String
  vibe      String
  embedding String?
  createdAt DateTime @default(now())
}

model CachedJob {
  id                String   @id
  title             String
  company           String
  sector            String
  city              String
  country           String
  seniority         String
  skills            Json
  salaryMin         Int?
  salaryMax         Int?
  remote            Boolean  @default(false)
  internshipCountry String?
  source            String
  url               String
  postedAt          String
  description       String
  fetchedAt         DateTime @default(now())
}

model JobsFetchMeta {
  id          Int      @id @default(1)
  lastFetched DateTime @default(now())
}
