generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model LeaderboardEntry {
  id        Int      @id @default(autoincrement())
  alias     String
  score     Int
  topSkill  String
  createdAt DateTime @default(now())
}

model CofounderProfile {
  id        Int      @id @default(autoincrement())
  alias     String
  email     String
  skills    String
  interests String
  vibe      String
  embedding String?
  createdAt DateTime @default(now())
}
